      "name": "Get Voucher By Id"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json.result;\n\n// normalize discount type\nconst discountTypeText =\n  item.discountType === 1\n    ? \"Giảm theo số tiền\"\n    : item.discountType === 2\n      ? \"Giảm theo phần trăm\"\n      : \"Không xác định\";\n\nconst content = `\nLoại: voucher\nTên: ${item.name}\nMã voucher: ${item.code}\n\nLoại giảm giá: ${discountTypeText}\nGiá trị giảm: ${item.discountValue || 0}\nGiảm tối đa: ${item.maxDiscount || 0}\nĐơn tối thiểu áp dụng: ${item.minInvoiceAmount || 0}\n\nSố lượng phát hành: ${item.totalQuantity || 0}\nGiới hạn mỗi người: ${item.perUserLimit || 1}\n\nThời gian áp dụng:\n- Bắt đầu: ${item.startDate}\n- Kết thúc: ${item.endDate}\n\nTrạng thái: ${item.status === 1 ? \"Đang hoạt động\" : \"Không hoạt động\"}\n\nMô tả: ${item.description || \"Không có mô tả\"}\n`.trim();\n\nreturn [\n  {\n    content,\n    payload: {\n      type: \"voucher\",\n      id: String(item.id),\n      code: item.code,\n      discountType: item.discountType,\n      discountValue: item.discountValue,\n      maxDiscount: item.maxDiscount,\n      minInvoiceAmount: item.minInvoiceAmount,\n      totalQuantity: item.totalQuantity,\n      startDate: item.startDate,\n      endDate: item.endDate,\n      perUserLimit: item.perUserLimit,\n      status: item.status,\n      branchId: item.branchId\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        624
      ],
      "id": "d4d998ce-0e99-4fc7-806a-5cb74e5943d8",
      "name": "Voucher Prompt Prepare"
    },
    {
      "parameters": {
        "jsCode": "const payload = $('Data Prepare').first().json.payload;\n\nconst TYPE_MAP = {\n  product: 1,\n  service: 2,\n  voucher: 3\n};\n\nconst typeCode = TYPE_MAP[payload.type];\n\nif (!typeCode) {\n  throw new Error(`Unknown type: ${payload.type}`);\n}\n\nconst pointId = typeCode * 10_000_000 + Number(payload.id);\n\nreturn [\n  {\n    json: {\n      ...$json,\n      pointId\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
