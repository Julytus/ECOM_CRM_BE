    {
      "parameters": {
        "jsCode": "const item = $input.first().json.result;\n\nconst content = `\nDịch vụ: ${item.name}\nMã dịch vụ: ${item.code}\nDanh mục: ${item.categoryName || \"Không có danh mục\"}\nGiá dịch vụ: ${item.price} VNĐ\nChi phí gốc: ${item.cost} VNĐ\nCác loại giá trong combo: ${item.priceVariation}\nGói combo: ${item.isCombo ? \"Có\" : \"Không\"}\nChi nhánh: ${item.branchId}\n% Giảm giá: ${item.discount}\nMô tả: ${item.intro || \"Không có mô tả\"}\n`.trim();\n\nreturn [\n  {\n    content,\n    payload: {\n      type: \"service\",\n      id: String(item.id),\n      name: item.name,\n      code: item.code,\n      categoryId: item.categoryId,\n      categoryName: item.categoryName,\n      price: item.price,\n      cost: item.cost,\n      discount: item.discount,\n      status: item.status,\n      branchId: item.branchId,\n      isCombo: item.isCombo,\n      priceVariation: item.priceVariation,\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        432
      ],
      "id": "abc8ebfa-2491-4ba8-b437-28dfc77436d9",
      "name": "Service Prompt Prepare"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json.result;\n\nconst content = `\nSản phẩm: ${item.name}\nMã sản phẩm: ${item.code}\nDanh mục: ${item.categoryName}\nGiá: ${item.price} VNĐ\nĐơn vị: ${item.unitName}\nChi nhánh: ${item.branchId}\nSố tiền giảm giá: ${item.discount}\nĐơn vị giảm giá (1: phần trăm, 2: VNĐ): ${item.discountUnit}\nMô tả: ${item.content || \"Không có mô tả\"}\n`.trim();\n\nreturn [\n  {\n    content,\n    payload: {\n      type: \"product\",\n      id: String(item.id),\n      name: item.name,\n      code: item.code,\n      categoryId: item.categoryId,\n      categoryName: item.categoryName,\n      price: item.price,\n      discount: item.discount,\n      discountUnit: item.discountUnit,\n      status: item.status,\n      branchId: item.branchId,\n      unitName: item.unitName\n    }\n  }\n];"
      },
