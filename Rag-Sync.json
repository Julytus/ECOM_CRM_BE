    {
      "parameters": {
        "jsCode": "const body = $('Sync Webhook').first().json.body;\nconst type = String(body.type || '').toLowerCase();\n\nconst must = [\n  {\n    key: \"type\",\n    match: { value: type }\n  },\n  {\n    key: \"id\",\n    match: { value: String(body.id) }\n  }\n];\n\nif (type === 'product' || type === 'service') {\n  must.push({\n    key: \"branchId\",\n    match: { value: body.branchId }\n  });\n}\n\nreturn [\n  {\n    filter: {\n      must\n    }\n  }\n];"
      },
